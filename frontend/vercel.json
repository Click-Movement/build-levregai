{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "node scripts/vercel-build.cjs",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/aios",
      "destination": "/aios/",
      "permanent": false
    },
    {
      "source": "/aios-certified",
      "destination": "/aios/",
      "permanent": true
    },
    {
      "source": "/aios-certified/",
      "destination": "/aios/",
      "permanent": true
    },
    {
      "source": "/plan",
      "destination": "/plan/",
      "permanent": false
    },
    {
      "source": "/apply",
      "destination": "/apply/",
      "permanent": false
    },
    {
      "source": "/install-call",
      "destination": "/install-call/",
      "permanent": false
    },
    {
      "source": "/install-call-complete",
      "destination": "/install-call-complete/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/aios/",
      "destination": "/aios/index.html"
    },
    {
      "source": "/plan/",
      "destination": "/plan/index.html"
    },
    {
      "source": "/apply/",
      "destination": "/apply/index.html"
    },
    {
      "source": "/install-call/",
      "destination": "/install-call/index.html"
    },
    {
      "source": "/install-call-complete/",
      "destination": "/install-call-complete/index.html"
    },
    {
      "source": "/go/medspa/:path*",
      "destination": "https://medspa-amber.vercel.app/:path*"
    },
    {
      "source": "/go/medspa",
      "destination": "https://medspa-amber.vercel.app/"
    },
    {
      "source": "/scorecard/:path*",
      "destination": "https://three-engine-scorecard.vercel.app/:path*"
    },
    {
      "source": "/scorecard",
      "destination": "https://three-engine-scorecard.vercel.app/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
